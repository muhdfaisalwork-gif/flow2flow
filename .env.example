# 1. Supabase Free Tier (50,000 MAUs + 500MB Postgres + 500K Edge Invocations FREE)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-public-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# 2. Zero-Cost Monthly Subscription Checkout URLs ($0/month fixed cost)
# Create a free account at https://lemonsqueezy.com or https://polar.sh
# They act as your Merchant of Record, handle global VAT/Sales Tax, and only
# take ~5% AFTER a customer pays you!
VITE_LEMONSQUEEZY_PRO_MONTHLY_URL=""
VITE_LEMONSQUEEZY_PRO_ANNUAL_URL=""
VITE_LEMONSQUEEZY_ENTERPRISE_MONTHLY_URL=""
VITE_LEMONSQUEEZY_ENTERPRISE_ANNUAL_URL=""

# Optional: Polar.sh Checkout URLs (alternative $0/mo Merchant of Record)
VITE_POLAR_PRO_URL=""
VITE_POLAR_ENTERPRISE_URL=""
